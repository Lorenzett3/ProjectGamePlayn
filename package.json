{
  "name": "gameplayn-mvp",
  "version": "1.0.0",
  "description": "MVP de forum/rede social de games com React, Node, SQLite/PostgreSQL e SCSS.",
  "main": "server.js",
  "scripts": {
    "start": "node --no-warnings scripts/start-sqlite-api.js",
    "api": "node --no-warnings scripts/start-sqlite-api.js",
    "api:sqlite": "node --no-warnings scripts/start-sqlite-api.js",
    "api:postgres": "node server.js",
    "api:memory": "node scripts/start-memory-api.js",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "node --no-warnings scripts/start-sqlite-api.js",
    "seed:demo": "node --no-warnings scripts/enrich-demo-data.js",
    "test": "node --no-warnings --test tests/*.test.js",
    "test:backend": "node --test tests/api.test.js",
    "test:database": "node --test tests/database.test.js",
    "test:front": "npm run build"
  },
  "keywords": [
    "games",
    "forum",
    "rede-social",
    "mvp"
  ],
  "author": "Lorenzett3",
  "license": "MIT",
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "dotenv": "^17.4.2",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.80.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
